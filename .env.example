# Optional: override data directory (absolute path, or path relative to fomc_tools/)
# DATA_DIR=data

# Optional: OpenAI for abstractive summary (works without key — field stays null)
# OPENAI_API_KEY=

# Optional: Loughran-McDonald MasterDictionary path (tab-separated, Word column)
# LM_DICT_PATH=

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# API authentication key — required for /api/v1/* in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave commented out during local development to skip enforcement.
# API_KEY=

# Use XGBoost instead of LogisticRegression when training (optional)
# USE_XGBOOST=0

# --- External data API keys ---
# FRED API key (free at https://fred.stlouisfed.org/docs/api/api_key.html)
# Used by core/fred_api.py for proper API calls; falls back to CSV download if absent.
# FRED_API_KEY=

# NewsAPI.org key (free developer plan at https://newsapi.org/register — 100 req/day)
# Used by core/news_fetcher.py as secondary news source.
# NEWS_API_KEY=

# Alpha Vantage key (free at https://www.alphavantage.co/support/#api-key — 500 calls/day)
# Used by core/news_fetcher.py as primary financial news + sentiment source.
# ALPHA_VANTAGE_KEY=

# Logging
# LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_FORMAT=text         # text | json  (use json for log aggregators)
# LOG_FILE=               # optional: path to rotating log file
